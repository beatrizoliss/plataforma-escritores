<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E5D3B3"
    tools:context=".MainActivity2" >

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="170dp"
        android:layout_height="153dp"
        android:layout_marginTop="68dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logotiposemfundo" />


    <TextView
        android:id="@+id/textView2"
        style="Serif"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="54dp"
        android:layout_marginBottom="9dp"
        android:fontFamily="serif"
        android:text="LOGIN"
        android:textAlignment="gravity"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textColor="#2E1814"
        android:textStyle="normal|bold"
        app:layout_constraintBottom_toTopOf="@+id/txtemail"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/txtemail"
        android:layout_width="296dp"
        android:layout_height="38dp"
        android:layout_marginStart="44dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/cantos"

        android:backgroundTint="#FFF6EA"
        android:ems="10"
        android:hint="Email"
        android:inputType="text"
        android:textColor="#A6A6A6"
        app:layout_constraintBottom_toTopOf="@+id/txtsenha"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/txtsenha"
        android:layout_width="297dp"
        android:layout_height="38dp"
        android:layout_marginStart="44dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/cantos"
        android:backgroundTint="#FFF6EA"
        android:ems="10"
        android:hint="Senha"
        android:inputType="text"
        android:textColor="#A6A6A6"
        app:layout_constraintBottom_toTopOf="@+id/txtesqueceu"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtesqueceu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="129dp"
        android:layout_marginBottom="44dp"
        android:fontFamily="serif"
        android:text="Esqueceu a senha?"
        android:textAllCaps="false"
        android:textColor="#CD853F"
        android:textStyle="normal|bold|italic"
        app:layout_constraintBottom_toTopOf="@+id/button3"
        app:layout_constraintStart_toEndOf="@+id/imgShowPassword" />

    <Button
        android:id="@+id/button3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="154dp"
        android:layout_marginEnd="155dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#CD853F"
        android:text="ENTRAR"
        android:textColor="#2E1814"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/imageView4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="185dp"
        android:layout_height="169dp"
        android:layout_marginStart="107dp"
        android:layout_marginEnd="119dp"
        android:layout_marginBottom="13dp"
        app:layout_constraintBottom_toTopOf="@+id/textView3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/pena" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="52dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="serif"
        android:text="Você não tem conta?"
        android:textColor="#2E1814"
        android:textSize="14sp"
        android:textStyle="normal|bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtcadastro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="serif"
        android:text="Cadastre-se"
        android:textColor="#CD853F"
        android:textStyle="normal|bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/textView3" />

    <ImageView
        android:id="@+id/imgShowPassword"
        android:layout_width="36dp"
        android:layout_height="29dp"
        android:layout_marginStart="52dp"
        android:layout_marginBottom="275dp"
        app:layout_constraintBottom_toTopOf="@+id/textView3"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/olho" />

    <TextView
        android:id="@+id/textView20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginBottom="45dp"
        android:fontFamily="serif"
        android:text="Mostrar senha"
        android:textColor="#2E1814"
        android:textSize="12sp"
        android:textStyle="normal|bold"
        app:layout_constraintBottom_toTopOf="@+id/button3"
        app:layout_constraintStart_toEndOf="@+id/imgShowPassword" />

</androidx.constraintlayout.widget.ConstraintLayout>